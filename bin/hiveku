#!/usr/bin/env node
/**
 * The Hiveku CLI that the plugin's slash commands drive.
 *
 * Everything here is non-interactive and supports --json, because the caller is
 * usually Claude rather than a human: the slash command runs a subcommand,
 * reads the JSON, and talks to the user itself. Human-readable output is the
 * fallback, not the contract.
 *
 * Nothing in here ever prints a full account key.
 */
import path from 'node:path';
import os from 'node:os';
import { promises as fs, readFileSync } from 'node:fs';
import { spawnSync } from 'node:child_process';
import {
  resolveDataDir,
  readCredentials,
  upsertAccounts,
  removeAccount,
  publicAccountList,
} from '../lib/credentials.mjs';
import { resolveBinding, writeBinding, removeBinding, looksLikeHivekuFolder } from '../lib/binding.mjs';
import { decideWithGuardrails } from '../lib/tool-safety.mjs';
import { parseFocus } from '../lib/tool-focus.mjs';
import { detectExtensionServer, describeCollision } from '../lib/collision.mjs';
import { runLoopbackConsent, exchangeCode, revokeSelf, keysToRotate, startPasteConsent, finishPasteConsent } from '../lib/connect.mjs';
import { runPullData } from '../lib/pulldata.mjs';
import { pullKnowledge, knowledgeStatus } from '../lib/knowledge.mjs';
import { runSetup, DEFAULT_ROOT_NAME } from '../lib/setup.mjs';
import { provisionSettings, planProvision, settingsPath } from '../lib/provision.mjs';
import { Upstream } from '../lib/upstream.mjs';
import { HIVEKU_APP_URL, HIVEKU_MCP_URL, CLIENT_ID, PLUGIN_VERSION, keyPreview, isUuid, mapLimit } from '../lib/util.mjs';

const HELP = `hiveku ${PLUGIN_VERSION} — Hiveku for Claude Code

  connect [--manual]            Connect Hiveku accounts through the browser
  accounts [--json]             List connected accounts (never prints keys)
  accounts add <key>            Store an account key directly (escape hatch)
  accounts remove <account-id>  Revoke the key server-side, then forget it
  setup [--root <path>]         Create + bind one folder per connected account
                                (default root: ~/Hiveku-Accounts)
  bind [--account <id>] [--dir <path>]
                                Bind a directory to one connected account
  unbind [--dir <path>]         Remove this directory's binding
  status [--json] [--dir <path>]
                                What this directory is bound to, and to what else
  pull [<dept ...>] [--default | --all | --stale [h] | --dataset <dept:id> | --list]
                                Pull department data into hiveku-data/ for the
                                bound account (local files beat live calls)
  knowledge [pull|status]       Sync account memory/rules/skills into this
                                folder by department (pull), or report drift
                                (status). Never deletes local files.
  focus [<departments...>|--clear] [--json]
  env pull <project_id> write .env.local for local dev (values never printed)
  fleet                 read-only portfolio sweep across every connected account
  hook <session-start|cwd-changed|pre-tool-use>
  update                        Refresh the marketplace and apply the plugin update
  doctor [--fix]                Check (and repair) the Claude settings Hiveku needs on this machine
                                Internal: used by the plugin's hooks

Keys live in the plugin's private data directory, encrypted with a key held in
your OS keychain. They are never written into a project.`;

function parseFlags(argv) {
  const flags = {};
  const positional = [];
  const valued = new Set(['account', 'dir', 'app-url', 'root', 'code']);
  for (let i = 0; i < argv.length; i++) {
    const a = argv[i];
    if (a.startsWith('--')) {
      const name = a.slice(2);
      if (valued.has(name)) flags[name] = argv[++i];
      else flags[name] = true;
    } else {
      positional.push(a);
    }
  }
  return { flags, positional };
}

function out(json, obj, humanLines) {
  if (json) process.stdout.write(JSON.stringify(obj, null, 2) + '\n');
  else process.stdout.write(humanLines.join('\n') + '\n');
}

function fail(message, code = 1) {
  process.stderr.write(`hiveku: ${message}\n`);
  process.exit(code);
}

/* ── connect ─────────────────────────────────────────────────────────────── */

/**
 * Store a consent payload: map, rotate, upsert, revoke, report. One
 * implementation for every return path — loopback, paste-back, and whatever
 * comes next — because the rotation ordering here is load-bearing (compute
 * rotations BEFORE the upsert, revoke only AFTER the store succeeds) and a
 * second copy of it would drift.
 */
async function storeConnectPayload(dataDir, existing, payload, flags) {
  const incoming = payload.accounts.map((a) => ({
    account_id: a.account_id,
    key: a.api_key,
    label: a.account_name || a.account_id,
    scope: a.scope || payload.scope || 'full',
    connected_as: payload.connected_as || null,
    departments: payload.departments || [],
  }));

  const rotations = keysToRotate(existing.accounts, incoming);
  await upsertAccounts(dataDir, incoming);

  const rotationFailures = [];
  if (rotations.length) {
    const outcomes = await mapLimit(rotations, 6, async (r) => ({ ...r, result: await revokeSelf(r.oldKey) }));
    for (const o of outcomes) if (!o.result.ok) rotationFailures.push(o);
  }

  const rows = incoming.map((a) => ({
    account_id: a.account_id,
    label: a.label,
    scope: a.scope,
    key_preview: keyPreview(a.key),
  }));

  out(
    flags.json,
    {
      connected: rows,
      connected_as: payload.connected_as || null,
      rotated: rotations.length - rotationFailures.length,
      rotation_failures: rotationFailures.map((o) => ({ account_id: o.account_id, reason: o.result.reason })),
    },
    [
      `Connected ${rows.length} account${rows.length === 1 ? '' : 's'}:`,
      ...rows.slice(0, 20).map((r) => `  ${r.label}  (${r.account_id}, ${r.scope})`),
      ...(rows.length > 20 ? [`  … and ${rows.length - 20} more`] : []),
      ...(rotations.length
        ? [`Rotated ${rotations.length - rotationFailures.length} of ${rotations.length} replaced key${rotations.length === 1 ? '' : 's'} (old keys revoked server-side).`]
        : []),
      ...rotationFailures.map(
        (o) => `  WARNING: could not revoke the old key for ${o.label} (${o.result.reason}) — it is still active; revoke it at app.hiveku.com > Settings > LLM Connectors.`,
      ),
      '',
      'Next: run "hiveku setup" to create + bind a folder per account (or /hiveku:bind in a folder of your own).',
    ],
  );
}

async function cmdConnect(flags) {
  const dataDir = resolveDataDir();
  // ★ Refuse to START a consent flow that cannot FINISH. Sending someone to
  // the browser, having them tick accounts and paste a code, and then failing
  // on the credential save is the worst order of operations available.
  const writable = await dataDirWritable(dataDir);
  if (!writable.ok) {
    fail(
      `This session cannot save Hiveku credentials: the sandbox blocks writes to ${writable.dir} ` +
        `(${writable.code}). Connecting here would fail at the last step, so nothing was started.\n\n` +
        SANDBOX_WRITE_FIX + '\n\n' +
        'No settings access? A technical user can instead run this once in a terminal outside Claude ' +
        '(it is not sandboxed there) and every session on this machine will then see the accounts:\n' +
        `  ${process.argv[1] || 'hiveku'} connect`,
      3,
    );
  }
  const existing = await readCredentials(dataDir);
  const appUrl = flags['app-url'] || HIVEKU_APP_URL;

  let payload;
  if (flags.manual) {
    fail(
      'Manual connection: create a key at app.hiveku.com (Settings > LLM Connectors) on any ' +
        'device, then on this machine run: hiveku accounts add <key>. The key is validated ' +
        'against the live server before anything is stored.',
      2,
    );
  }

  // ── finish half of the paste-back flow: `connect --code <code>` ──────────
  if (flags.code) {
    payload = await finishPasteConsent({ dataDir, code: String(flags.code) });
    await storeConnectPayload(dataDir, existing, payload, flags);
    return;
  }

  // ── start half, explicitly requested: `connect --paste` ──────────────────
  if (flags.paste) {
    const { url, voidedPrevious } = await startPasteConsent({ appUrl, alreadyConnected: Object.keys(existing.accounts), dataDir });
    out(flags.json, { paste_url: url, voided_previous: voidedPrevious }, [
      ...(voidedPrevious ? ['NOTE: a previous attempt was still waiting for a code. That code is now void - only the NEW page below works.', ''] : []),
      'Open this page, pick the accounts to connect, and approve:',
      `  ${url}`,
      '',
      'The page will show a one-time code. Paste it back and run:',
      '  hiveku connect --code <code>',
      'The code expires in 10 minutes and only works on this machine.',
    ]);
    return;
  }

  process.stderr.write('hiveku: opening your browser to approve access...\n');
  try {
    payload = await runLoopbackConsent({
      appUrl,
      alreadyConnected: Object.keys(existing.accounts),
      onUrl: (url) => process.stderr.write(`hiveku: if the browser did not open, visit:\n${url}\n`),
    });
  } catch (err) {
    // ★ The sandbox cannot listen — fall THROUGH to the paste flow instead of
    // failing with instructions. Same consent page, same cherry-picking; the
    // return trip becomes a code the page displays and the user pastes back.
    // This is what turns a dead end into a one-message detour for the
    // non-technical user the error used to strand.
    if (err?.code !== 'ELOOPBACKBLOCKED') throw err;
    const { url, voidedPrevious } = await startPasteConsent({ appUrl, alreadyConnected: Object.keys(existing.accounts), dataDir });
    out(flags.json, { paste_url: url, loopback_blocked: true, voided_previous: voidedPrevious }, [
      ...(voidedPrevious ? ['NOTE: a previous attempt was still waiting for a code. That code is now void - only the NEW page below works.', ''] : []),
      'This session cannot receive the browser redirect (sandbox blocks the callback port),',
      'so we will do it by code instead — no terminal needed:',
      '',
      '  1. Open this page, pick the accounts to connect, choose read-only where it fits, approve:',
      `       ${url}`,
      '  2. The page will show a one-time code. Paste it back here.',
      '  3. Then run:  hiveku connect --code <code>',
      '',
      'The code expires in 10 minutes, works once, and is useless off this machine.',
    ]);
    return;
  }
  await storeConnectPayload(dataDir, existing, payload, flags);
  return;

}

/* ── accounts ────────────────────────────────────────────────────────────── */

async function cmdAccounts(flags, positional) {
  const dataDir = resolveDataDir();
  const sub = positional[0];

  if (sub === 'add') {
    const key = positional[1];
    if (!key || !/^(hvk|olp)_/.test(key)) {
      fail('Pass an account key that starts with hvk_ (from app.hiveku.com > Settings > LLM Connectors).');
    }
    // Validate against the live server and learn which account it belongs to,
    // rather than trusting whatever the user believes it is.
    const probe = new Upstream({ key, accountId: 'unknown', label: 'unknown' });
    let info;
    try {
      const res = await probe.forward({ jsonrpc: '2.0', id: 1, method: 'tools/call', params: { name: 'get_account_info', arguments: {} } });
      info = parseToolJson(res);
    } catch (err) {
      fail(`That key did not work: ${err.message}`);
    }
    const accountId = info?.account_id || info?.id;
    if (!isUuid(accountId)) {
      fail('Hiveku accepted the key but did not return an account id. Nothing was stored.');
    }
    // A pasted key's access level can't be trusted from the user's memory — ask
    // the server (the authenticated GET /mcp info endpoint reports the enforced
    // scope). If this server doesn't report one yet, store nothing rather than
    // guessing: a read-only key labeled "full" is the wrong direction to be
    // wrong in, and this is exactly the contractor-pastes-a-key case.
    const scope = await fetchKeyScope(key);
    await upsertAccounts(dataDir, [
      { account_id: accountId, key, label: info.name || info.account_name || accountId, ...(scope ? { scope } : {}) },
    ]);
    out(flags.json, { added: { account_id: accountId, label: info.name || accountId, key_preview: keyPreview(key), scope: scope || 'unknown' } }, [
      `Stored the key for ${info.name || accountId} (${accountId}, ${scopeLabel(scope)} access).`,
      'Next: cd into that account\'s folder and run /hiveku:bind.',
    ]);
    return;
  }

  if (sub === 'remove') {
    const accountId = positional[1];
    if (!accountId) fail('Pass the account id to remove. Run "hiveku accounts" to see them.');
    const creds = await readCredentials(dataDir);
    const acct = creds.accounts[accountId];
    if (!acct) fail(`No stored key for ${accountId}.`);

    // Revoke FIRST and require proof. Deleting locally first would leave a live
    // key on the server that the user can no longer see or revoke.
    const revoked = await revokeSelf(acct.key);
    if (!revoked.ok) {
      fail(
        `Could not revoke the key server-side (${revoked.reason}). Nothing was deleted locally, so you ` +
          'can retry. Revoke it manually at app.hiveku.com > Settings > LLM Connectors if this persists.',
      );
    }
    await removeAccount(dataDir, accountId);
    out(flags.json, { removed: accountId, revoked: true }, [
      `Revoked and removed ${acct.label} (${accountId}).`,
    ]);
    return;
  }

  const creds = await readCredentials(dataDir);
  const list = publicAccountList(creds.accounts);
  out(flags.json, { accounts: list }, [
    list.length ? 'Connected accounts:' : 'No accounts connected yet. Run /hiveku:connect.',
    ...list.map((a) => `  ${a.label}  (${a.account_id}, ${a.scope})`),
  ]);
}

/**
 * Unwraps an Olympus tool result. The envelope is {data, total} and `data` is
 * usually an ARRAY even for single-record reads like get_account_info, so the
 * first element is the record.
 */
function parseToolJson(res) {
  const text = res?.result?.content?.[0]?.text;
  if (typeof text !== 'string') return null;
  try {
    const parsed = JSON.parse(text);
    const data = parsed && typeof parsed === 'object' && 'data' in parsed ? parsed.data : parsed;
    if (Array.isArray(data)) return data[0] ?? null;
    return data ?? null;
  } catch {
    return null;
  }
}

/**
 * Ask the server what a key is actually allowed to do. GET /mcp is the
 * authenticated info endpoint; servers deployed since 2026-08-25 include the
 * enforced `scope` in it. Returns 'full' | 'read_only' | null (unknown) — and
 * never throws, because failing to LEARN the scope must not fail the add.
 */
async function fetchKeyScope(key) {
  try {
    const res = await fetch(HIVEKU_MCP_URL, {
      method: 'GET',
      headers: { Authorization: `Bearer ${key}`, Accept: 'application/json', 'X-Hiveku-Client': CLIENT_ID },
    });
    if (!res.ok) return null;
    const info = await res.json().catch(() => null);
    return info?.scope === 'read_only' || info?.scope === 'full' ? info.scope : null;
  } catch {
    return null;
  }
}

/** Human wording for a stored scope. Unknown stays unknown — never claim full. */
function scopeLabel(scope) {
  if (scope === 'read_only') return 'read-only';
  if (scope === 'full') return 'full';
  return 'unknown';
}


/* ── bind / unbind / status ──────────────────────────────────────────────── */

/* ── setup ───────────────────────────────────────────────────────────────── */

async function cmdSetup(flags) {
  const dataDir = resolveDataDir();
  const creds = await readCredentials(dataDir);
  const ids = Object.keys(creds.accounts);
  if (!ids.length) fail('No accounts connected yet. Run /hiveku:connect first.');

  const root = flags.root || path.join(os.homedir(), DEFAULT_ROOT_NAME);
  const { root: rootAbs, results } = await runSetup({ root, accounts: creds.accounts });

  // A SaaS roster can be hundreds of accounts; print the interesting rows in
  // full and summarize the bulk (the --json output always carries everything).
  const HUMAN_ROW_CAP = 20;
  const interesting = results.filter((r) => r.status === 'conflict' || r.status === 'error');
  const routine = results.filter((r) => r.status !== 'conflict' && r.status !== 'error');
  const counts = results.reduce((m, r) => ((m[r.status] = (m[r.status] || 0) + 1), m), {});
  const lines = [
    `Account folders under ${rootAbs}: ` +
      Object.entries(counts).map(([k, n]) => `${n} ${k}`).join(', '),
  ];
  for (const r of interesting) {
    if (r.status === 'conflict') lines.push(`  CONFLICT ${r.dir} is already bound to a different account (${r.bound_to}) — left untouched`);
    else lines.push(`  ERROR    ${r.dir}: ${r.error}`);
  }
  for (const r of routine.slice(0, HUMAN_ROW_CAP)) {
    lines.push(`  ${r.status.padEnd(8)} ${r.dir}  -> ${r.label}`);
  }
  if (routine.length > HUMAN_ROW_CAP) {
    lines.push(`  … and ${routine.length - HUMAN_ROW_CAP} more (use --json for the full list)`);
  }
  lines.push('', 'Open any of these folders in Claude (the Code tab\'s folder picker, or cd) and the account is live.');
  lines.push('Inside one, /hiveku:pull fetches its department data and /hiveku:knowledge its memory and skills.');
  out(flags.json, { root: rootAbs, results }, lines);

  if (results.some((r) => r.status === 'error')) process.exit(1);
}

async function cmdBind(flags) {
  const dataDir = resolveDataDir();
  const dir = path.resolve(flags.dir || process.cwd());
  const creds = await readCredentials(dataDir);
  const list = publicAccountList(creds.accounts);

  if (flags.list || !flags.account) {
    out(flags.json, { accounts: list, dir }, [
      list.length
        ? `Accounts available to bind to ${dir}:`
        : 'No accounts connected yet. Run /hiveku:connect first.',
      ...list.map((a) => `  ${a.account_id}  ${a.label} (${a.scope})`),
      list.length ? '\nRun: hiveku bind --account <id>' : '',
    ]);
    return;
  }

  const account = creds.accounts[flags.account];
  if (!account) fail(`No stored key for ${flags.account}. Run /hiveku:connect, or "hiveku accounts" to list.`);

  if (path.resolve(dir) === path.resolve(os.homedir())) {
    fail('Refusing to bind your home directory: that would attach an account to every folder on this machine.');
  }

  const file = await writeBinding(dir, {
    accountId: flags.account,
    label: account.label,
    keyPreview: account.key_preview,
  });
  await ensureGitignore(dir);

  out(flags.json, { bound: { account_id: flags.account, label: account.label, dir, file } }, [
    `Bound ${dir} to ${account.label} (${flags.account}, ${scopeLabel(account.scope)} access).`,
    'Hiveku tools activate when this directory\'s MCP server next starts — reconnect "hk" under /mcp,',
    'or start a new session here.',
  ]);
}

/** Keeps local Hiveku state out of the user's git history. */
async function ensureGitignore(dir) {
  const file = path.join(dir, '.gitignore');
  const wanted = ['.hiveku/', 'hiveku-data/'];
  let current = '';
  try {
    current = await fs.readFile(file, 'utf8');
  } catch {
    /* no .gitignore yet */
  }
  const lines = current.split('\n').map((l) => l.trim());
  const missing = wanted.filter((w) => !lines.includes(w));
  if (!missing.length) return;
  const addition = (current && !current.endsWith('\n') ? '\n' : '') + missing.join('\n') + '\n';
  await fs.writeFile(file, current + addition, 'utf8');
}

async function cmdUnbind(flags) {
  const dir = path.resolve(flags.dir || process.cwd());
  const removed = await removeBinding(dir);
  out(flags.json, { unbound: removed, dir }, [
    removed ? `Unbound ${dir}.` : `${dir} was not bound.`,
    removed
      ? 'Any hiveku-data/ and knowledge files here still hold that account\'s data; delete them if you meant to fully detach.'
      : '',
  ]);
}

/* ── pull ────────────────────────────────────────────────────────────────── */

async function cmdPull(flags, positional) {
  const dir = path.resolve(flags.dir || process.cwd());
  const binding = await resolveBinding(dir);
  if (!binding) {
    fail(`${dir} is not bound to a Hiveku account. Run /hiveku:bind first (and /hiveku:connect before that if needed).`);
  }
  const dataDir = resolveDataDir();
  const creds = await readCredentials(dataDir);
  const account = creds.accounts[binding.accountId];
  if (!account) {
    fail(`This folder is bound to ${binding.label} (${binding.accountId}) but no key for it is stored here. Run /hiveku:connect.`);
  }

  // Rebuild the runner's argv grammar from parsed flags (parseFlags split them).
  let argv;
  if (flags.list) argv = ['--list'];
  else if (flags.dataset) argv = ['--dataset', positional[0] || ''];
  else if (flags.all) argv = ['--all'];
  else if (flags.default) argv = ['--default'];
  else if (flags.stale) {
    const hours = positional.find((p) => Number(p) > 0);
    argv = hours ? ['--stale', hours] : ['--stale'];
  } else argv = positional;

  const result = await runPullData({
    rootDir: binding.dir,
    endpoint: HIVEKU_MCP_URL,
    key: account.key,
    argv,
    log: (line) => process.stdout.write(line + '\n'),
  });
  if (!result.ok) {
    fail('Every dataset failed — the stored key may be dead. Run /hiveku:status, then /hiveku:connect to re-mint.');
  }
}

/* ── knowledge ───────────────────────────────────────────────────────────── */

async function cmdKnowledge(flags, positional) {
  const dir = path.resolve(flags.dir || process.cwd());
  const binding = await resolveBinding(dir);
  if (!binding) {
    fail(`${dir} is not bound to a Hiveku account. Run /hiveku:bind first (and /hiveku:connect before that if needed).`);
  }
  const dataDir = resolveDataDir();
  const creds = await readCredentials(dataDir);
  const account = creds.accounts[binding.accountId];
  if (!account) {
    fail(`This folder is bound to ${binding.label} (${binding.accountId}) but no key for it is stored here. Run /hiveku:connect.`);
  }

  const sub = positional[0] || 'pull';
  if (sub === 'status') {
    const status = await knowledgeStatus({ rootDir: binding.dir, endpoint: HIVEKU_MCP_URL, key: account.key });
    out(flags.json, status, [
      status.initialized ? `Knowledge sync status for ${account.label}:` : 'Knowledge was never pulled here. Run: hiveku knowledge pull',
      ...(status.initialized
        ? [
            `  in sync: ${status.in_sync}`,
            `  changed upstream: ${status.changed_remote.length ? status.changed_remote.join(', ') : 'none'}`,
            `  new upstream: ${status.new_remote.length ? status.new_remote.join(', ') : 'none'}`,
            `  deleted upstream (still on disk): ${status.deleted_remote.length ? status.deleted_remote.join(', ') : 'none'}`,
            `  locally modified: ${status.locally_modified.length ? status.locally_modified.join(', ') : 'none'}`,
          ]
        : []),
    ]);
    return;
  }
  if (sub !== 'pull') fail(`Unknown knowledge subcommand "${sub}". Use: hiveku knowledge [pull|status]`);

  const result = await pullKnowledge({
    rootDir: binding.dir,
    endpoint: HIVEKU_MCP_URL,
    key: account.key,
    log: (line) => process.stdout.write(line + '\n'),
  });
  out(flags.json, result, [
    `Pulled ${result.written} knowledge entr${result.written === 1 ? 'y' : 'ies'} for ${account.label} (by department).`,
  ]);
}

/**
 * `hiveku fleet` - the portfolio view the one-folder-one-account model cannot
 * give from inside a single session.
 *
 * READ-ONLY BY CONSTRUCTION: for each stored account it makes exactly two
 * calls - get_account_info (liveness + identity) and agent_inbox_list
 * (urgent items) - with THAT account's own key. It never mixes keys, never
 * writes, and a dead key is a row in the report rather than an abort. This is
 * the Monday-morning sweep; deep dives stay per-folder where the binding
 * pins the tenant.
 */
/**
 * `hiveku env pull <project_id>` - materialize .env.local for local dev
 * WITHOUT the secret values ever entering a model's context.
 *
 * The VS Code extension's "Pull Env" was the only way to get this file, which
 * gated plain-terminal local dev on installing the extension. Same contract
 * here: values go straight from the API into the file (0600), and this
 * process prints ONLY key names and counts. Transform rules match the
 * extension and the platform docs: _PROD/_PRODUCTION/_STAGING keys are
 * deploy-only and SKIPPED; a _DEV key overrides its base name locally.
 * Server-side sensitive keys never arrive at all (write-only by design) -
 * their names land in the file as comments so the dev knows what is missing
 * rather than debugging a mystery.
 */
async function cmdEnv(flags, positional) {
  if (positional[0] !== 'pull') fail('Usage: hiveku env pull <project_id> [--dir <folder>]');
  const projectId = positional[1];
  if (!isUuid(projectId)) fail('Pass the website project UUID (from sites_list).');
  const dir = path.resolve(flags.dir || process.cwd());
  const binding = await resolveBinding(dir);
  if (!binding) fail(`${dir} is not bound to a Hiveku account. Run /hiveku:bind first.`);
  const creds = await readCredentials(resolveDataDir());
  const account = creds.accounts[binding.accountId];
  if (!account) fail(`Bound to ${binding.label} but no key stored. Run /hiveku:connect.`);

  const up = new Upstream({ key: account.key, accountId: binding.accountId, label: account.label });
  const res = await up.forward({ jsonrpc: '2.0', id: 1, method: 'tools/call',
    params: { name: 'project_secrets_list', arguments: { project_id: projectId } } });
  const body = parseToolJson(res);
  if (!body || typeof body !== 'object' || body.error) {
    fail(`Could not read project secrets: ${body?.error || 'unexpected response shape'}`);
  }
  const secrets = body.secrets || {};
  const sensitive = Array.isArray(body.sensitive_keys) ? body.sensitive_keys : [];

  const out = {};
  const skipped = [];
  for (const [k, v] of Object.entries(secrets)) {
    if (/_(PROD|PRODUCTION|STAGING)$/.test(k)) { skipped.push(k); continue; }
    if (/_DEV$/.test(k)) { out[k.replace(/_DEV$/, '')] = v; continue; }
    if (!(k in out)) out[k] = v; // a _DEV override that arrived first wins
  }
  const lines = [
    '# Written by `hiveku env pull` - gitignore this file.',
    ...Object.entries(out).map(([k, v]) => `${k}=${v}`),
    ...(sensitive.length
      ? ['', '# These keys exist but are write-only server-side (marked sensitive);',
         '# set them by hand if local dev needs them:',
         ...sensitive.map((k) => `# ${k}=`)]
      : []),
    '',
  ];
  const target = path.join(dir, '.env.local');
  await fs.writeFile(target, lines.join('\n'), { mode: 0o600 });
  process.stdout.write(
    `Wrote ${Object.keys(out).length} keys to .env.local (values not shown): ` +
    `${Object.keys(out).sort().join(', ')}\n` +
    (skipped.length ? `Skipped ${skipped.length} deploy-only: ${skipped.sort().join(', ')}\n` : '') +
    (sensitive.length ? `Sensitive (set by hand if needed): ${sensitive.sort().join(', ')}\n` : ''),
  );
}

async function cmdFleet(flags) {
  const dataDir = resolveDataDir();
  const creds = await readCredentials(dataDir);
  const ids = Object.keys(creds.accounts || {});
  if (!ids.length) fail('No accounts connected. Run /hiveku:connect first.');

  const rows = [];
  for (const accountId of ids) {
    const acct = creds.accounts[accountId];
    const up = new Upstream({ key: acct.key, accountId, label: acct.label });
    const row = { account_id: accountId, label: acct.label, scope: acct.scope || 'full' };
    try {
      const res = await up.forward({ jsonrpc: '2.0', id: 1, method: 'tools/call',
        params: { name: 'get_account_info', arguments: {} } });
      const info = parseToolJson(res);
      row.reachable = true;
      row.account_name = info?.name || info?.account_name || acct.label;
    } catch (err) {
      row.reachable = false;
      row.error = String(err?.message || err).slice(0, 140);
      rows.push(row);
      continue; // an unreachable account gets no second call
    }
    try {
      const inbox = await up.forward({ jsonrpc: '2.0', id: 2, method: 'tools/call',
        params: { name: 'agent_inbox_list', arguments: { status: 'open', limit: 50 } } });
      const items = parseToolJson(inbox);
      const list = Array.isArray(items) ? items : items?.items || items?.data || [];
      row.open_inbox_items = Array.isArray(list) ? list.length : null;
      row.urgent = Array.isArray(list)
        ? list.filter((i) => i?.severity === 'urgent').map((i) => String(i?.title || '').slice(0, 90))
        : [];
    } catch {
      row.open_inbox_items = null; // reported as unknown, never as zero
    }
    rows.push(row);
  }

  if (flags.json) {
    process.stdout.write(JSON.stringify({ accounts: rows }, null, 2) + '\n');
    return;
  }
  for (const r of rows) {
    const flag = !r.reachable ? 'UNREACHABLE' : r.urgent?.length ? `${r.urgent.length} URGENT` : 'ok';
    process.stdout.write(`${flag.padEnd(12)} ${r.label} (${r.account_id.slice(0, 8)}, ${r.scope})` +
      `${r.open_inbox_items != null ? ` - ${r.open_inbox_items} open inbox items` : ''}` +
      `${r.error ? ` - ${r.error}` : ''}\n`);
    for (const u of r.urgent || []) process.stdout.write(`             ! ${u}\n`);
  }
}

async function cmdStatus(flags) {
  const dir = path.resolve(flags.dir || process.cwd());
  let dataDir = null;
  let creds = { accounts: {} };
  let dataDirError = null;
  try {
    dataDir = resolveDataDir();
    creds = await readCredentials(dataDir);
  } catch (err) {
    dataDirError = err.message;
  }

  const binding = await resolveBinding(dir);
  const account = binding ? creds.accounts[binding.accountId] : null;
  const detected = await detectExtensionServer(dir);
  const collision = describeCollision(detected, account?.label || null, creds.accounts);

  const result = {
    dir,
    bound: Boolean(binding),
    account_id: binding?.accountId || null,
    label: account?.label || binding?.label || null,
    scope: account?.scope || null,
    key_stored: Boolean(account),
    binding_file: binding?.file || null,
    connected_accounts: publicAccountList(creds.accounts).length,
    extension_server_present: Boolean(detected),
    collision_warning: collision,
    data_dir_error: dataDirError,
  };

  const human = [];
  if (dataDirError) human.push(`Warning: ${dataDirError}`);
  if (!binding) {
    human.push(`${dir} is not bound to a Hiveku account.`);
    human.push(
      result.connected_accounts
        ? 'Run /hiveku:bind to pick one of your connected accounts.'
        : 'Run /hiveku:connect to connect an account.',
    );
  } else if (!account) {
    human.push(`Bound to ${binding.label} (${binding.accountId}) but no key is stored on this machine.`);
    human.push('Run /hiveku:connect to reconnect.');
  } else {
    human.push(`Bound to ${account.label} (${binding.accountId}, ${scopeLabel(account.scope)} access).`);
  }
  if (collision) human.push('', collision);

  out(flags.json, result, human);
}

/* ── hooks ───────────────────────────────────────────────────────────────── */

/**
 * SessionStart / CwdChanged output. Kept to what is load-bearing: which account
 * is live, and whether a second Hiveku connection is also live. Silence is the
 * default, because this plugin is installed once at user scope and is therefore
 * present in every project on the machine.
 */
/**
 * Warn when this session's bridge is older than what is installed.
 *
 * A Claude session pins the plugin version it started with, so a long-lived
 * session keeps running the bridge it spawned even after an update lands. Field
 * testing found eight bridges alive at once across five versions, including one
 * on 0.2.0 that had been serving a session for nearly sixteen hours, five
 * versions behind. Nothing anywhere said so, and the symptom is not an error:
 * it is missing tools and stale skills, which reads as "Hiveku cannot do that".
 *
 * Derived from CLAUDE_PLUGIN_ROOT rather than a hardcoded path, because the root
 * IS the versioned cache directory, so its siblings are the other installed
 * versions. Returns null on anything unexpected: a version notice is a courtesy
 * and must never be the reason a session start fails.
 */
async function describeVersionSkew() {
  try {
    const root = process.env.CLAUDE_PLUGIN_ROOT;
    if (!root) return null;
    const manifest = JSON.parse(await fs.readFile(path.join(root, '.claude-plugin', 'plugin.json'), 'utf8'));
    const running = String(manifest.version || '').trim();
    if (!running) return null;

    const entries = await fs.readdir(path.dirname(path.resolve(root)), { withFileTypes: true });
    const cmp = (a, b) => {
      const pa = a.split('.').map(Number), pb = b.split('.').map(Number);
      for (let i = 0; i < Math.max(pa.length, pb.length); i++) {
        const d = (pa[i] || 0) - (pb[i] || 0);
        if (d) return d;
      }
      return 0;
    };
    const versions = entries
      .filter((e) => e.isDirectory() && /^\d+(\.\d+)*$/.test(e.name))
      .map((e) => e.name);
    if (!versions.length) return null;
    const newest = versions.reduce((a, b) => (cmp(a, b) >= 0 ? a : b));

    // ★ The case that stranded a user on 0.9.1 for three releases: the
    // marketplace clone has already PULLED a newer version — the pipeline
    // worked — but nobody pressed Update, so every fixed bug still looks
    // broken. Detect it here, where it costs one local file read, and name
    // the command that finishes the job.
    const avail = availablePluginUpdate(newest);
    if (avail) {
      return (
        `Hiveku: plugin ${avail.available} is available (this machine has ${newest}). ` +
        'Run /hiveku:update, then /reload-plugins to apply it in this session.'
      );
    }

    if (cmp(newest, running) <= 0) return null;

    return (
      `Hiveku: this session is running plugin ${running}, but ${newest} is installed. A session keeps ` +
      'the bridge it started with, so newer tools and skills are missing here until you start a new ' +
      'session. Symptoms look like missing capability rather than an error.'
    );
  } catch {
    return null;
  }
}

/**
 * Choose which departments' tools this directory advertises.
 *
 * ★ A CONTEXT TRIM, NOT AN ACCESS CONTROL. Every tool remains reachable when
 * named directly; this only shortens the advertised list, which is where ~255
 * tokens per tool are spent before a session starts. The real boundary is a
 * scoped key. See lib/tool-focus.mjs.
 */
async function cmdFocus(flags, positional) {
  const dir = process.cwd();
  const binding = await resolveBinding(dir);
  if (!binding) {
    process.stdout.write('This directory is not bound to a Hiveku account. Run /hiveku:bind first.\n');
    process.exitCode = 1;
    return;
  }

  const file = binding.file;
  const parsed = JSON.parse(await fs.readFile(file, 'utf8'));

  if (flags.clear) parsed.departments = [];
  else if (positional.length) parsed.departments = parseFocus(positional);

  if (flags.clear || positional.length) {
    await writeFileAtomic(file, JSON.stringify(parsed, null, 2) + '\n');
  }

  const current = parseFocus(parsed.departments);
  if (flags.json) {
    process.stdout.write(JSON.stringify({ account: binding.label, departments: current }) + '\n');
    return;
  }
  if (!current.length) {
    process.stdout.write(
      `${binding.label}: showing ALL tools (~1,500). That costs roughly 380k tokens of context ` +
      `before you type anything.\nNarrow it with e.g.  /hiveku:focus ppc marketing\n`);
  } else {
    process.stdout.write(
      `${binding.label}: focused on ${current.join(', ')}.\n` +
      `Other tools are hidden from the list but still work if named directly.\n` +
      `Restart the session for this to take effect. Clear it with /hiveku:focus --clear\n`);
  }
}

/* ── self-update ─────────────────────────────────────────────────────────── */

/**
 * What version does the LOCAL marketplace clone advertise, vs what is running?
 *
 * ★ LOCAL FILE READS ONLY — this is called from the session-start hook, which
 * must never wait on the network. The clone is what the app's own updater
 * pulls in the background, so comparing against it answers "has an update
 * already ARRIVED that the user simply has not applied", which is the common
 * case: the pipeline works, the last click does not happen. A user sat on
 * 0.9.1 for three releases this way and read every fixed bug as still broken.
 */
function availablePluginUpdate(baseline = PLUGIN_VERSION, homeDir = os.homedir()) {
  try {
    const raw = readFileSync(
      path.join(homeDir, '.claude', 'plugins', 'marketplaces', 'hiveku', '.claude-plugin', 'marketplace.json'),
      'utf8',
    );
    const advertised = JSON.parse(raw)?.plugins?.find?.((pl) => pl?.name === 'hiveku')?.version;
    if (!advertised || typeof advertised !== 'string') return null;
    const num = (v) => v.split('.').map((n) => parseInt(n, 10) || 0);
    const [a, b] = [num(advertised), num(baseline)];
    for (let i = 0; i < 3; i++) {
      if ((a[i] ?? 0) > (b[i] ?? 0)) return { installed: baseline, available: advertised };
      if ((a[i] ?? 0) < (b[i] ?? 0)) return null;
    }
    return null;
  } catch {
    return null; // no clone, unreadable JSON — never break session start over this
  }
}

/**
 * `hiveku update` — refresh the marketplace and apply the plugin update.
 *
 * Wraps the app's own commands rather than reimplementing them: `claude plugin
 * marketplace update` is the same fast-forward the background updater does,
 * and `claude plugin update` is the same install the /plugin UI button runs.
 * If the `claude` binary is not reachable (some Desktop sandboxes), fall back
 * to fast-forwarding the clone directly and point at the UI for the last step.
 */
async function cmdUpdate(flags) {
  const before = PLUGIN_VERSION;
  const run = (args) => spawnSync('claude', args, { encoding: 'utf8', timeout: 120_000 });

  const mk = run(['plugin', 'marketplace', 'update', 'hiveku']);
  if (mk.error?.code === 'ENOENT') {
    // No claude CLI here. The clone is a plain git checkout; do its fast-forward.
    const clone = path.join(os.homedir(), '.claude', 'plugins', 'marketplaces', 'hiveku');
    const pull = spawnSync('git', ['-C', clone, 'pull', 'origin', 'HEAD'], { encoding: 'utf8', timeout: 120_000 });
    const avail = availablePluginUpdate(PLUGIN_VERSION);
    out(flags.json, { installed: before, available: avail?.available ?? before, applied: false, pulled: pull.status === 0 }, [
      pull.status === 0 ? 'Marketplace refreshed.' : `Could not refresh the marketplace: ${(pull.stderr || '').trim().slice(0, 200)}`,
      avail
        ? `Version ${avail.available} is ready (you are on ${before}). Apply it in /plugin > hiveku > Update, then restart the session.`
        : `You are on the newest version (${before}).`,
    ]);
    return;
  }

  const up = run(['plugin', 'update', 'hiveku@hiveku']);
  const ok = up.status === 0;
  // Report what the marketplace now advertises, not a diff against whichever
  // copy of this script happens to be executing — run from a repo checkout the
  // baseline lies.
  let now = null;
  try {
    const raw = readFileSync(
      path.join(os.homedir(), '.claude', 'plugins', 'marketplaces', 'hiveku', '.claude-plugin', 'marketplace.json'),
      'utf8',
    );
    now = JSON.parse(raw)?.plugins?.find?.((pl) => pl?.name === 'hiveku')?.version ?? null;
  } catch { /* fine — the human line degrades gracefully */ }
  out(
    flags.json,
    { applied: ok, now_installed: now, detail: (up.stdout || up.stderr || '').trim().slice(0, 300) },
    ok
      ? [
          `Updated${now ? ` to ${now}` : ''}.`,
          '★ This session still runs the old version. Run /reload-plugins to apply it here without',
          'restarting (one-time prompt-cache cost), or just start the next session normally.',
        ]
      : [
          `Update did not complete: ${(up.stderr || up.stdout || 'unknown error').trim().slice(0, 300)}`,
          'Fallback: open /plugin, pick hiveku, press Update, restart the session.',
        ],
  );
}

const DISMISS_FILE = 'onboarding-dismissed';

/**
 * ★ CAN THIS PROCESS WRITE ITS OWN DATA DIRECTORY? Claude Desktop's sandbox
 * blocks every write outside the working folder and the session temp dir --
 * the plugin's credential store, the paste-flow verifier, the dismiss marker
 * and the update cache all live outside both. The first production run of the
 * paste-back flow died on `EPERM ... pending-connect.json` AFTER the user had
 * already been told to approve in the browser; the credential save at the end
 * would have failed the same way. Probe with a real open-for-write, because
 * fs.access() can pass under a sandbox that denies the write itself.
 */
async function dataDirWritable(dataDir) {
  const probe = path.join(dataDir, '.write-probe');
  try {
    await fs.mkdir(dataDir, { recursive: true });
    await fs.writeFile(probe, '', { mode: 0o600 });
    await fs.rm(probe, { force: true });
    return { ok: true };
  } catch (e) {
    return { ok: false, code: e?.code || 'unknown', dir: dataDir };
  }
}

const SANDBOX_WRITE_FIX =
  'The plugin repairs this itself: it is applied automatically the next time a session starts, or ' +
  'now with "hiveku doctor --fix" (run from a terminal if this session is sandboxed). Then start a ' +
  'NEW session. Admins can push the same settings to every machine via managed settings.';



async function onboardingDismissed(dataDir) {
  try { await fs.access(path.join(dataDir, DISMISS_FILE)); return true; } catch { return false; }
}

/** Does ANY bound client folder exist under ~/Hiveku-Accounts? */
async function anyBoundFolderExists(homeDir = os.homedir()) {
  try {
    const root = path.join(homeDir, DEFAULT_ROOT_NAME);
    for (const e of await fs.readdir(root, { withFileTypes: true })) {
      if (!e.isDirectory()) continue;
      try { await fs.access(path.join(root, e.name, '.hiveku', 'account.json')); return true; } catch { /* next */ }
    }
  } catch { /* no root yet */ }
  return false;
}

/**
 * `hiveku doctor [--fix]` — is this machine able to run Hiveku, and repair it.
 *
 * Every check here is a real failure seen in production this week, each of
 * which previously surfaced as a late, misleading error somewhere else.
 */
async function cmdDoctor(flags) {
  const dataDir = resolveDataDir();
  const writable = await dataDirWritable(dataDir);
  let settings = {};
  try { settings = JSON.parse(await fs.readFile(settingsPath(), 'utf8')); } catch { /* absent or invalid */ }
  const plan = planProvision(settings);
  const missing = plan.changes;

  let fixed = null;
  if (flags.fix && missing.length) fixed = await provisionSettings();

  const rows = [
    `plugin            ${PLUGIN_VERSION}`,
    `data dir          ${writable.ok ? 'writable' : `NOT writable (${writable.code}) — ${dataDir}`}`,
    `claude settings   ${missing.length ? `missing: ${missing.join(', ')}` : 'complete'}`,
    ...(fixed ? [fixed.applied
      ? `repaired          ${fixed.changes.join(', ')} → ${fixed.file} (backup beside it). Start a NEW session.`
      : `repair failed     ${fixed.error}`] : []),
    ...(!flags.fix && missing.length ? ['', 'Run "hiveku doctor --fix" to repair, or start a new session (it repairs itself).'] : []),
  ];
  out(flags.json, { version: PLUGIN_VERSION, data_dir_writable: writable.ok, missing, fixed }, rows);
  if (!writable.ok || (missing.length && !fixed?.applied)) process.exitCode = 1;
}

/** `hiveku onboarding --dismiss` — the user said no; stop offering. */
async function cmdOnboarding(flags) {
  const dataDir = resolveDataDir();
  if (flags.dismiss) {
    await fs.mkdir(dataDir, { recursive: true });
    await fs.writeFile(path.join(dataDir, DISMISS_FILE), new Date().toISOString() + '\n', { mode: 0o600 });
    out(flags.json, { dismissed: true }, ['Understood - the setup offer will not appear again on this machine.']);
    return;
  }
  out(flags.json, { dismissed: await onboardingDismissed(dataDir) }, ['Pass --dismiss to silence the first-run setup offer.']);
}

async function cmdHook(positional) {
  const which = positional[0];
  const payload = await readHookStdin();

  // ── PreToolUse: answered before any I/O ────────────────────────────────
  // This one runs on EVERY tool call, so it must not read credentials, resolve
  // a binding, or touch the network -- the other hook events fire once per
  // session and can afford that; this cannot.
  //
  // It only ever ADDS an approval, and only for this plugin's own read-only
  // tools. Silence is the answer for everything else, which leaves the normal
  // permission flow exactly as it was.
  if (which === 'pre-tool-use') {
    const decision = decideWithGuardrails(payload);
    if (decision) process.stdout.write(JSON.stringify(decision));
    return;
  }

  const dir = path.resolve(payload?.cwd || process.cwd());

  let creds = { accounts: {} };
  // ★ Nullable on purpose. resolveDataDir() THROWS when no data dir can be
  // located, and a hook that lets that escape prints NOTHING: the session
  // starts silent, which reads as "the plugin is not installed". Every use
  // below must tolerate null.
  let hookDataDir = null;
  try {
    hookDataDir = resolveDataDir();
    creds = await readCredentials(hookDataDir);
  } catch {
    return; // no data dir: stay silent, the shim already explains itself
  }

  const binding = await resolveBinding(dir);
  const account = binding ? creds.accounts[binding.accountId] : null;
  const lines = [];

  if (which === 'cwd-changed') {
    // The MCP server pinned its account at spawn. If the user has moved into a
    // folder belonging to a different account, say so — never silently re-pin.
    const projectDir = process.env.CLAUDE_PROJECT_DIR;
    if (projectDir) {
      const sessionBinding = await resolveBinding(path.resolve(projectDir));
      if (binding && sessionBinding && binding.accountId !== sessionBinding.accountId) {
        lines.push(
          `Hiveku: this directory belongs to ${binding.label}, but the live Hiveku connection is pinned ` +
            `to ${sessionBinding.label} from session start. Start a new session here to work on ${binding.label}.`,
        );
      }
    }
  } else {
    if (binding && account) {
      // ★ This is the ONLY channel that reaches every session unconditionally,
      // and until now it spent all of itself on one rule.
      //
      // The plugin holds ~2.5 MB of operating knowledge — more than the Python
      // agent servers carry — but theirs is PUSHED into every turn while all
      // of the plugin's past ~26 KB must be PULLED: the model has to decide to
      // open a skill, from a one-line description, before it knows it needs
      // the rule. Every observed failure so far has been a pull-path failure
      // on knowledge the plugin already had. So spend the one guaranteed
      // channel on the pointer, not on a single rule: name the read-first
      // skill, and name the tool that makes the other ~1,650 findable.
      lines.push(
        `Hiveku: bound to ${account.label} (${binding.accountId}, ${scopeLabel(account.scope)} access). ` +
          'Before any write: confirm with get_account_info, and check project_version_log / project_files_status ' +
          'because you are not the only writer. ' +
          'When the user asks for Hiveku work, read the hiveku-orient skill before acting — it carries ' +
          'the hard stops and the rules that are not inferable from tool names. For plain conversation, ' +
          'greetings, or non-Hiveku tasks there is nothing to load and nothing to verify — just respond. ' +
          'Only a handful of tools are advertised: hiveku_find_tools searches the other ~1,650, so search ' +
          'before concluding a capability does not exist. If the user seems unsure what to do on this ' +
          'account, offer /hiveku:start - it reads what is actually connected and names a few things ' +
          'worth doing this week.',
      );
    } else if (binding && !account) {
      lines.push(
        `Hiveku: this directory is bound to ${binding.label} but no key for it is stored here. Run /hiveku:connect.`,
      );
    } else if (Object.keys(creds.accounts).length === 0 && !(hookDataDir && (await onboardingDismissed(hookDataDir)))) {
      // ★ THE ZERO STATE MUST SPEAK. The silence rule below (unrelated folder,
      // say nothing) is right for a machine that is set up — but on a machine
      // with the plugin installed and NO accounts connected, silence means the
      // user who does not know the vocabulary meets a session that was told
      // nothing. That pairing is how a staff member stares at a working
      // installation and concludes Hiveku is broken. One line, and it deletes
      // itself the moment the first account connects.
      // Every walk of a simulated onboarding audit broke at the same seam: the
      // old ending said "then /hiveku:start in one of them", the current
      // session's folder is never one of them, and start's unbound gate then
      // scripted "run /hiveku:bind" at a non-technical user, aimed at a
      // scratch folder. The chain must END IN A HANDOFF, not a command.
      lines.push(
        'Hiveku: installed, but no accounts are connected on this machine yet. If the user brings up ' +
        'Hiveku, their clients, or seems unsure where to begin with their agency or client work, ' +
        'OFFER to set it up and drive it end to end yourself: run /hiveku:connect (relay the page ' +
        'link it prints; they tick accounts in the browser and paste back a code), then ' +
        '/hiveku:setup to create a bound folder per account. Then HAND OFF - tell them to open one ' +
        'of the new folders from the Code tab folder picker and simply ask "where should I start?" ' +
        'there. Do NOT run /hiveku:start or /hiveku:bind in THIS session; this folder stays ' +
        'unbound and Hiveku tools only wake in a new session inside a bound folder. Assume no ' +
        'technical vocabulary and never send them to a terminal - every step runs here in the ' +
        'conversation. Never volunteer any of this during unrelated technical work, and if they ' +
        'decline once, drop it: run "${CLAUDE_PLUGIN_ROOT}/bin/hiveku" onboarding --dismiss and ' +
        'do not raise Hiveku again.',
      );
    } else if (
      Object.keys(creds.accounts).length > 0 &&
      !(await anyBoundFolderExists())
    ) {
      // ★ The orphaned middle of onboarding: connect succeeded, then the chat
      // was closed before setup ran. The next session used to say NOTHING —
      // accounts silently connected, no workspace anywhere, and a user with
      // no vocabulary to ask. One line resumes the chain where it stopped;
      // it deletes itself as soon as setup creates the first bound folder.
      lines.push(
        `Hiveku: ${Object.keys(creds.accounts).length} account(s) are connected on this machine but ` +
        'no client folders exist yet - setup never finished. Offer to complete it: run ' +
        '/hiveku:setup (one ready folder per account under ~/Hiveku-Accounts), then hand off to ' +
        'the folder picker. Do not bind THIS folder unless the user chose it for a client.',
      );
    } else if (await looksLikeHivekuFolder(dir)) {
      lines.push('Hiveku: this looks like a Hiveku account folder but is not bound. Run /hiveku:bind.');
    }
    // No Hiveku artifacts and nothing bound: print NOTHING.
  }

  const detected = await detectExtensionServer(dir);
  const collision = describeCollision(detected, account?.label || null, creds.accounts);
  if (collision) lines.push(collision);

  // Only when we already have a reason to speak. An unrelated folder that is
  // unbound and has no Hiveku artifacts must stay completely silent, and a
  // version notice is not worth breaking that for.
  if (lines.length) {
    const skew = await describeVersionSkew();
    if (skew) lines.push(skew);
    // A sandbox that blocks the data dir turns connect, update and the
    // onboarding dismiss into late-stage failures. Say so up front, once.
    // ★ PROVISION, DON'T INSTRUCT. Hooks run outside the Bash sandbox, so this
    // is the one place the plugin can repair the user's settings itself.
    // Additive, idempotent, backed up. A user who installed the plugin has
    // asked for it to work; nobody has to know a settings key exists.
    const prov = await provisionSettings().catch((e) => ({ applied: false, changes: [], error: e?.message || String(e) }));
    if (prov.applied) {
      lines.push(
        `Hiveku: configured Claude for Hiveku (${prov.changes.join(', ')}) — takes effect in the next ` +
        'session. Tell the user once, in one sentence, if they ask why a restart helps.',
      );
    } else if (prov.error) {
      lines.push(
        `Hiveku: Claude's settings still need ${prov.changes.join(', ')} and this session could not write ` +
        `them (${prov.error}). Ask the user to run "hiveku doctor --fix" in a terminal once, or an admin ` +
        'to push managed settings; connect and update will refuse to start until then.',
      );
    }
  }

  if (lines.length) process.stdout.write(lines.join('\n') + '\n');
}

async function readHookStdin() {
  if (process.stdin.isTTY) return null;
  const chunks = [];
  for await (const c of process.stdin) chunks.push(c);
  const raw = Buffer.concat(chunks).toString('utf8').trim();
  if (!raw) return null;
  try {
    return JSON.parse(raw);
  } catch {
    return null;
  }
}

/* ── entry ───────────────────────────────────────────────────────────────── */

async function main() {
  const [, , cmd, ...rest] = process.argv;
  const { flags, positional } = parseFlags(rest);

  switch (cmd) {
    case 'connect': return cmdConnect(flags);
    case 'accounts': return cmdAccounts(flags, positional);
    case 'setup': return cmdSetup(flags);
    case 'bind': return cmdBind(flags);
    case 'focus': return cmdFocus(flags, positional);
    case 'unbind': return cmdUnbind(flags);
    case 'status': return cmdStatus(flags);
    case 'fleet': return cmdFleet(flags);
    case 'env': return cmdEnv(flags, positional);
    case 'pull': return cmdPull(flags, positional);
    case 'knowledge': return cmdKnowledge(flags, positional);
    case 'hook': return cmdHook(positional);
    case 'update': return cmdUpdate(flags);
    case 'onboarding': return cmdOnboarding(flags);
    case 'doctor': return cmdDoctor(flags);
    case 'version': case '--version': process.stdout.write(PLUGIN_VERSION + '\n'); return;
    default:
      process.stdout.write(HELP + '\n');
      if (cmd && cmd !== 'help' && cmd !== '--help' && cmd !== '-h') process.exit(1);
  }
}

main().catch((err) => fail(err?.message || String(err)));
