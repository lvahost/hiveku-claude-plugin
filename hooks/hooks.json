{
  "description": "Reports which Hiveku account this directory is bound to, warns when a second Hiveku connection is live in the same session, and pre-approves Hiveku's read-only tools so a sweep does not stall on one permission check per tool.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "HIVEKU_PLUGIN_DATA=\"${CLAUDE_PLUGIN_DATA}\" \"${CLAUDE_PLUGIN_ROOT}/bin/hiveku\" hook session-start",
            "statusMessage": "Hiveku: checking account binding"
          }
        ]
      }
    ],
    "CwdChanged": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "HIVEKU_PLUGIN_DATA=\"${CLAUDE_PLUGIN_DATA}\" \"${CLAUDE_PLUGIN_ROOT}/bin/hiveku\" hook cwd-changed"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "mcp__plugin_hiveku_hk__.*",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/hiveku\" hook pre-tool-use"
          }
        ]
      }
    ]
  }
}
